{
  "name": "improve-ui-skill",
  "version": "0.3.1",
  "private": true,
  "description": "Evidence-gated Codex skill for improving existing web interfaces.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "npm run test:full",
    "test:core": "node scripts/run-tests.mjs --profile core",
    "test:unit": "npm run test:core",
    "test:browser": "node scripts/run-tests.mjs --profile browser",
    "test:full": "npm run test:core && npm run test:browser",
    "validate": "node scripts/validate-skill.mjs SKILLS/improve-ui",
    "validate:evals": "node scripts/validate-evals.mjs evals/scenarios.json",
    "check:syntax": "node --check SKILLS/improve-ui/scripts/detect-ui-antipatterns.mjs && node --check SKILLS/improve-ui/scripts/run-interface-review.mjs && node --check SKILLS/improve-ui/scripts/generate-design-report.mjs",
    "check:core": "npm run validate && npm run validate:evals && npm run check:syntax && npm run test:core",
    "check:full": "npm run check:core && npm run test:browser",
    "check": "npm run check:full"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
